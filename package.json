{
  "name": "inform-reloaded",
  "displayName": "Inform 7 Reloaded",
  "description": "Modern development environment for Inform 7",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.74.0"
  },
  "categories": [
    "Programming Languages",
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "languages": [
      {
        "id": "inform7",
        "aliases": ["Inform 7", "inform7"],
        "extensions": [".ni", ".i7"],
        "configuration": "./language-configuration.json"
      }
    ],
    "commands": [
      {
        "command": "inform7.compile",
        "title": "Compile Inform 7 Project"
      },
      {
        "command": "inform7.run",
        "title": "Run Inform 7 Story"
      }
    ],
    "configuration": [
      {
        "title": "Inform 7",
        "properties": {
          "inform7.compilerPath": {
            "type": "string",
            "default": "",
            "description": "Path to the Inform 7 compiler executable"
          },
          "inform7.sourceFile": {
            "type": "string",
            "default": "story.ni",
            "description": "Name of the main source file (relative to the Source directory)"
          }
        }
      },
      {
        "title": "Inform 7 Compiler Flags",
        "properties": {
          "inform7.compilerFlags.external": {
            "type": "string",
            "default": "",
            "description": "Path to external resources (-external)"
          },
          "inform7.compilerFlags.internal": {
            "type": "string",
            "default": "",
            "description": "Path to internal resources (-internal)"
          },
          "inform7.compilerFlags.transient": {
            "type": "string",
            "default": "",
            "description": "Path to temporary working directory (-transient)"
          },
          "inform7.compilerFlags.debug": {
            "type": "boolean",
            "default": false,
            "description": "Include debugging features (-debug)"
          },
          "inform7.compilerFlags.release": {
            "type": "boolean",
            "default": false,
            "description": "Build a release version (-release)"
          },
          "inform7.compilerFlags.basic": {
            "type": "boolean",
            "default": false,
            "description": "Use basic mode (-basic)"
          },
          "inform7.compilerFlags.output": {
            "type": "string",
            "default": "",
            "description": "Output file specification (-o)"
          }
        }
      },
      {
        "title": "Inform 7 Custom Flags",
        "properties": {
          "inform7.customFlags": {
            "type": "array",
            "default": [],
            "description": "Custom compiler flags (e.g. [\"-variable\", \"x=y\"])",
            "items": {
              "type": "string"
            }
          }
        }
      }
    ],
    "taskDefinitions": [
      {
        "type": "inform7",
        "required": ["projectPath"],
        "properties": {
          "projectPath": {
            "type": "string",
            "description": "Path to the Inform 7 project"
          },
          "debug": {
            "type": "boolean",
            "description": "Compile with debugging features"
          },
          "release": {
            "type": "boolean",
            "description": "Compile a release version"
          }
        }
      }
    ],
    "problemMatchers": [
      {
        "name": "inform7",
        "owner": "inform7",
        "source": "inform7",
        "fileLocation": ["relative", "${workspaceFolder}"],
        "pattern": {
          "regexp": "^INFORM7_ERROR\\|(.*?)\\|(\\d+)\\|(.*)$",
          "file": 1,
          "line": 2,
          "message": 3
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "^\\+\\+ (\\d+)% \\(([^)]+)\\)$",
          "endsPattern": "^\\+\\+ Ended: Translation (failed|succeeded): (\\d+) problem(s)? found$"
        }
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "webpack",
    "watch": "webpack --watch",
    "package": "webpack --mode production --devtool hidden-source-map",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "npm run compile-tests && npm run compile && npm run lint",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/vscode": "^1.76.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "20.x",
    "@typescript-eslint/eslint-plugin": "^8.31.1",
    "@typescript-eslint/parser": "^8.31.1",
    "eslint": "^9.25.1",
    "typescript": "^5.8.3",
    "ts-loader": "^9.5.2",
    "webpack": "^5.99.7",
    "webpack-cli": "^6.0.1",
    "@vscode/test-cli": "^0.0.10",
    "@vscode/test-electron": "^2.5.2"
  }
}
